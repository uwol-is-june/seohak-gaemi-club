      "expect": { "status": "적중", "directionHit": true }
    },
    {
      "name": "keep-down-5pct-40d → 적중(문턱 -10% 이내)",
      "call": { "id": "c5", "ticker": "X", "date": "2026-06-14", "skill": "s", "call": "keep", "priceAtCall": 100 },
