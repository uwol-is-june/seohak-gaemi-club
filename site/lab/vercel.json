{
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- .",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/picks.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
